<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
         http://maven.apache.org/xsd/maven-4.0.0.xsd">

    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>br.gov.go.saude.fhir</groupId>
        <artifactId>safira</artifactId>
        <version>1.0.0-SNAPSHOT</version>
        <relativePath>../../pom.xml</relativePath>
    </parent>

    <artifactId>safira-simulador</artifactId>
    <packaging>jar</packaging>
    <name>Safira :: Simulador</name>
    <description>Modo simulação: assinatura e validação pelo mesmo pipeline com raízes de confiança próprias (sem valor legal ICP-Brasil).</description>

    <dependencies>
        <dependency>
            <groupId>br.gov.go.saude.fhir</groupId>
            <artifactId>safira-steps</artifactId>
            <version>${project.version}</version>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-autoconfigure</artifactId>
        </dependency>

        <!-- ResponseBodyAdvice do aviso de simulação nas respostas de /validar -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>

        <dependency>
            <groupId>org.bouncycastle</groupId>
            <artifactId>bcpkix-jdk18on</artifactId>
        </dependency>

        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-api</artifactId>
        </dependency>

        <!-- Testing -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- Testes de sistema: safira-rest + simulador, com os auxiliares do rest e a PKI de teste do jades -->
        <dependency>
            <groupId>br.gov.go.saude.fhir</groupId>
            <artifactId>safira-rest</artifactId>
            <version>${project.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>br.gov.go.saude.fhir</groupId>
            <artifactId>safira-rest</artifactId>
            <version>${project.version}</version>
            <type>test-jar</type>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>br.gov.go.saude.fhir</groupId>
            <artifactId>safira-jades</artifactId>
            <version>${project.version}</version>
            <type>test-jar</type>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!-- JAR executável do gerador de PKI simulada (safira-simulador-*-exec.jar, opção saida)
                 ao lado do jar comum, que segue utilizável como biblioteca. -->
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <configuration>
                    <classifier>exec</classifier>
                    <mainClass>br.gov.go.saude.fhir.safira.simulador.GeradorPkiSimulada</mainClass>
                </configuration>
                <executions>
                    <execution>
                        <goals>
                            <goal>repackage</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

</project>
