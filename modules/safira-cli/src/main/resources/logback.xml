  CLI: todo log vai para o stderr; o stdout é reservado ao JSON de resultado. Stack trace só com
  verbose: a CLI define LOG_EXCEPTION_CONVERSION_WORD (%nopex sem a opção verbose, %ex com ela).
-->
<configuration>
    <appender name="STDERR" class="ch.qos.logback.core.ConsoleAppender">
        <target>System.err</target>
        <encoder>
            <pattern>%-5level %logger{36} - %msg%n${LOG_EXCEPTION_CONVERSION_WORD:-%nopex}</pattern>
        </encoder>
    </appender>

    <root level="WARN">
        <appender-ref ref="STDERR"/>
    </root>
</configuration>
