<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
         http://maven.apache.org/xsd/maven-4.0.0.xsd">

    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>br.gov.go.saude.fhir</groupId>
        <artifactId>safira</artifactId>
        <version>1.0.0-SNAPSHOT</version>
        <relativePath>../../pom.xml</relativePath>
    </parent>

    <artifactId>safira-rest</artifactId>
    <packaging>jar</packaging>
    <name>Safira :: REST</name>
    <description>Biblioteca da API REST do Safira (controllers e serviços registrados por auto-configuração).</description>

    <dependencies>
        <dependency>
            <groupId>br.gov.go.saude.fhir</groupId>
            <artifactId>safira-engine</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>br.gov.go.saude.fhir</groupId>
            <artifactId>safira-steps</artifactId>
            <version>${project.version}</version>
        </dependency>
        
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>

        <dependency>
            <groupId>com.fasterxml.jackson.core</groupId>
            <artifactId>jackson-databind</artifactId>
        </dependency>

        <!-- Health e probes (/actuator/health/readiness): o serviço só fica
             pronto depois que o acervo carrega (ver application.yml do safira-app). -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>


        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>


        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- PKI de teste e TSA local compartilhadas pelo módulo safira-jades -->
        <dependency>
            <groupId>br.gov.go.saude.fhir</groupId>
            <artifactId>safira-testkit</artifactId>
            <version>${project.version}</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!-- test-jar: compartilha os auxiliares dos testes de sistema com as aplicações e seus testes -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-jar-plugin</artifactId>
                <executions>
                    <execution>
                        <goals>
                            <goal>test-jar</goal>
                        </goals>
                        <configuration>
                            <excludes>
                                <exclude>application.yml</exclude>
                                <exclude>br/gov/go/saude/fhir/safira/rest/SafiraRestTestApplication*</exclude>
                            </excludes>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

</project>
