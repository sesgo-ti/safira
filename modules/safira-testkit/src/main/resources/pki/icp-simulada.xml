  PKI ICP-like SIMULADA (SEM VALOR LEGAL) para a PKI factory do EU DSS (pki.xsd do dss-pki-factory-jaxb).
  Datas relativas ao instante da carga. Sem crl/ocsp/caIssuers: as fontes em memória do testkit
  respondem sem URL (as URLs do XML viriam do pki.properties do DSS, com host real).
  issuer = serial do emissor + nome do emissor DELE (EntityId do JAXBPKILoader).
  O otherName CPF/CNPJ do SAN e o SERIALNUMBER do DN não são expressáveis aqui: o testkit reemite o
  signatário pela AC (PkiIcpSimulada).
-->
<pki xmlns="http://pki-factory.nowina.lu/pki-factory" name="icp-simulada" organization="SIMULACAO - SEM VALOR LEGAL" country="BR">

    <certificate>
        <serialNumber>1</serialNumber>
        <subject>AC Raiz Simulada SIMULACAO - SEM VALOR LEGAL</subject>
        <organization>SIMULACAO - SEM VALOR LEGAL</organization>
        <country>BR</country>
        <issuer serialNumber="1">AC Raiz Simulada SIMULACAO - SEM VALOR LEGAL</issuer>
        <notBefore month="-2"/>
        <notAfter year="20"/>
        <keyAlgo encryption="RSA" length="2048"/>
        <digestAlgo>SHA256</digestAlgo>
        <keyUsages>
            <keyUsage>keyCertSign</keyUsage>
            <keyUsage>crlSign</keyUsage>
        </keyUsages>
        <ca/>
        <trustAnchor/>
    </certificate>

    <certificate>
        <serialNumber>2</serialNumber>
        <subject>AC Simulada SIMULACAO - SEM VALOR LEGAL</subject>
        <organization>SIMULACAO - SEM VALOR LEGAL</organization>
        <country>BR</country>
        <issuer serialNumber="1">AC Raiz Simulada SIMULACAO - SEM VALOR LEGAL</issuer>
        <notBefore month="-2"/>
        <notAfter year="15"/>
        <keyAlgo encryption="RSA" length="2048"/>
        <digestAlgo>SHA256</digestAlgo>
        <keyUsages>
            <keyUsage>digitalSignature</keyUsage>
            <keyUsage>keyCertSign</keyUsage>
            <keyUsage>crlSign</keyUsage>
        </keyUsages>
        <ca/>
    </certificate>

    <!-- Signatário A3-like: política A3, digitalSignature|nonRepudiation, RSA 2048 -->
    <certificate>
        <serialNumber>3</serialNumber>
        <subject>Fulano de Tal SIMULACAO - SEM VALOR LEGAL</subject>
        <organization>SIMULACAO - SEM VALOR LEGAL</organization>
        <country>BR</country>
        <issuer serialNumber="2">AC Raiz Simulada SIMULACAO - SEM VALOR LEGAL</issuer>
        <notBefore month="-1"/>
        <notAfter year="10"/>
        <keyAlgo encryption="RSA" length="2048"/>
        <digestAlgo>SHA256</digestAlgo>
        <keyUsages>
            <keyUsage>digitalSignature</keyUsage>
            <keyUsage>nonRepudiation</keyUsage>
        </keyUsages>
        <certificatePolicies>
            <certificatePolicy>2.16.76.1.2.3.1</certificatePolicy>
        </certificatePolicies>
    </certificate>

    <!-- Signatário revogado ontem por comprometimento de chave -->
    <certificate>
        <serialNumber>4</serialNumber>
        <subject>Revogado SIMULACAO - SEM VALOR LEGAL</subject>
        <organization>SIMULACAO - SEM VALOR LEGAL</organization>
        <country>BR</country>
        <issuer serialNumber="2">AC Raiz Simulada SIMULACAO - SEM VALOR LEGAL</issuer>
        <notBefore month="-1"/>
        <notAfter year="10"/>
        <keyAlgo encryption="RSA" length="2048"/>
        <digestAlgo>SHA256</digestAlgo>
        <keyUsages>
            <keyUsage>digitalSignature</keyUsage>
            <keyUsage>nonRepudiation</keyUsage>
        </keyUsages>
        <certificatePolicies>
            <certificatePolicy>2.16.76.1.2.3.1</certificatePolicy>
        </certificatePolicies>
        <revocation day="-1" reason="keyCompromise"/>
    </certificate>

    <!-- TSA: EKU id-kp-timeStamping (o DSS o marca crítico) -->
    <certificate>
        <serialNumber>5</serialNumber>
        <subject>TSA Simulada SIMULACAO - SEM VALOR LEGAL</subject>
        <organization>SIMULACAO - SEM VALOR LEGAL</organization>
        <country>BR</country>
        <issuer serialNumber="2">AC Raiz Simulada SIMULACAO - SEM VALOR LEGAL</issuer>
        <notBefore month="-1"/>
        <notAfter year="10"/>
        <keyAlgo encryption="RSA" length="2048"/>
        <digestAlgo>SHA256</digestAlgo>
        <keyUsages>
            <keyUsage>digitalSignature</keyUsage>
        </keyUsages>
        <extendedKeyUsages>
            <extendedKeyUsage>1.3.6.1.5.5.7.3.8</extendedKeyUsage>
        </extendedKeyUsages>
    </certificate>

</pki>
